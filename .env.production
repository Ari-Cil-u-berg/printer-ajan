# Committed defaults for local production-mode runs (`npm run start:prod`).
# Packaged installers do NOT read this file — they use the presets in
# src/main/env.ts plus the environment baked in by scripts/write-build-env.mjs.
ARI_API_URL=https://api.ariadisyon.com
ARI_WS_URL=wss://api.ariadisyon.com/agent
ARI_LOG_LEVEL=info
ARI_LOG_CONSOLE=0
ARI_AUTO_UPDATE=0
