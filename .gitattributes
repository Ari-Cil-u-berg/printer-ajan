# Normalize line endings in the repo; check out native ones on Windows.
* text=auto eol=lf

# PowerShell is happiest with CRLF, and this file is executed by powershell.exe
# straight from the unpacked asar on Windows.
*.ps1 text eol=crlf

# Binaries — never diff, never munge line endings.
*.png binary
*.ico binary
*.icns binary
*.p12 binary
*.pfx binary

# Generated: keep it out of PR diffs, but still versioned (npm ci needs it).
package-lock.json linguist-generated=true -diff
