# Copy to `.env.local` (all environments) or `.env.development.local` (dev only).
# Real environment variables always win over these files, and .env files are read
# ONLY in unpackaged (dev) runs — a packaged installer takes its defaults from the
# environment baked in at build time (scripts/write-build-env.mjs).

# development | staging | production
# Normally set by the npm script, not here.
#ARI_ENV=development

# Gateway endpoints. Leave unset to use the preset for ARI_ENV (src/main/env.ts).
#ARI_API_URL=http://localhost:8787
#ARI_WS_URL=ws://localhost:8787/agent

# debug | info | warn | error
#ARI_LOG_LEVEL=debug

# Mirror log lines to stdout (1/0).
#ARI_LOG_CONSOLE=1

# Check GitHub releases for updates (1/0). Off in dev.
#ARI_AUTO_UPDATE=0

# Open devtools with the settings window (1/0).
#ARI_DEVTOOLS=0
